<%- include('partials/header') %>

<main class="main-content">
    <div class="container">
        <section class="history-section">
            <div class="section-header">
                <h1 class="section-title">
                    <i class="fas fa-history"></i>
                    Search History
                </h1>
                <p class="section-subtitle">Your recent weather searches</p>
            </div>
            
            <% if (history && history.length > 0) { %>
                <div class="card-grid stagger-animation">
                    <% history.forEach(item => { %>
                        <div class="card card-action">
                            <div class="card-header">
                                <div>
                                    <h3 class="card-title"><%= item.city %>, <%= item.country %></h3>
                                    <p class="card-subtitle">
                                        <i class="fas fa-clock"></i>
                                        <%= new Date(item.date).toLocaleDateString('en-US', { 
                                            weekday: 'short', 
                                            month: 'short', 
                                            day: 'numeric',
                                            hour: 'numeric',
                                            minute: 'numeric'
                                        }) %>
                                    </p>
                                </div>
                                <div class="card-icon">
                                    <img src="http://openweathermap.org/img/wn/<%= item.icon %>@2x.png" 
                                         alt="<%= item.description %>">
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="temperature-display">
                                    <span class="current-temp"><%= Math.round(item.temp) %>°C</span>
                                    <span class="weather-desc"><%= item.description %></span>
                                </div>
                                
                                <div class="card-stats">
                                    <div class="stat-item">
                                        <i class="fas fa-temperature-high"></i>
                                        <span class="stat-value"><%= Math.round(item.feels_like) %>°C</span>
                                        <span class="stat-label">Feels Like</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="fas fa-tint"></i>
                                        <span class="stat-value"><%= item.humidity %>%</span>
                                        <span class="stat-label">Humidity</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="fas fa-wind"></i>
                                        <span class="stat-value"><%= Math.round(item.wind_speed) %></span>
                                        <span class="stat-label">Wind (m/s)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a href="/weather?city=<%= item.city %>" class="action-button">
                                    <i class="fas fa-eye"></i>
                                    View Current Weather
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card card-highlight empty-state">
                    <i class="fas fa-history"></i>
                    <h3 class="card-title">No Search History</h3>
                    <p>Your weather search history will appear here</p>
                    <a href="/" class="action-button">
                        <i class="fas fa-search"></i>
                        Search Weather
                    </a>
                </div>
            <% } %>
        </section>
    </div>
</main>

<%- include('partials/footer') %> 